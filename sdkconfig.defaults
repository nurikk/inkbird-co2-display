# Enable frame pointer for better backtraces
CONFIG_ESP_SYSTEM_USE_EH_FRAME=y
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y

# Increase task watchdog timeout (e-paper refresh can be slow)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Enable more verbose logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

CONFIG_ESPTOOLPY_FLASHSIZE_2MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ============================================================================
# LVGL Font Configuration
# ============================================================================
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# ============================================================================
# Bluetooth (Bluedroid) Configuration for Inkbird BLE sensors
# ============================================================================

# Enable Bluetooth
CONFIG_BT_ENABLED=y

# Use Bluedroid stack
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n

# BLE only mode (no classic BT)
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# Bluedroid BLE configuration
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y

# Memory optimization
CONFIG_BT_BTU_TASK_STACK_SIZE=4096
CONFIG_BT_BLE_ACL_BUF_COUNT=10
CONFIG_BT_BLE_ACL_BUF_SIZE=255

# ============================================================================
# System Configuration
# ============================================================================
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
