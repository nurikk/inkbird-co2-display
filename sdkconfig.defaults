# Enable frame pointer for better backtraces
CONFIG_ESP_SYSTEM_USE_EH_FRAME=y
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y

# Increase task watchdog timeout (e-paper refresh can be slow)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Enable more verbose logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

CONFIG_ESPTOOLPY_FLASHSIZE_2MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ============================================================================
# LVGL Font Configuration
# ============================================================================
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# ============================================================================
# Bluetooth (NimBLE) Configuration for Inkbird BLE sensors
# NimBLE uses ~40KB less memory than Bluedroid
# ============================================================================

# Enable Bluetooth
CONFIG_BT_ENABLED=y

# Use NimBLE stack (lighter weight than Bluedroid)
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# NimBLE role configuration - we are a central (client)
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# NimBLE memory settings
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_MAX_CCCDS=8
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=0

# NimBLE GAP settings
CONFIG_BT_NIMBLE_GAP_DEVICE_NAME_MAX_LEN=32

# NimBLE GATT settings
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# NimBLE security
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y

# Scan duplicate filter
CONFIG_BT_NIMBLE_SCAN_DUPL_TYPE_DEVICE=y
CONFIG_BT_NIMBLE_SCAN_DUPL_CACHE_SIZE=100

# NimBLE task configuration
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y

# Enable extended advertising for better compatibility
CONFIG_BT_NIMBLE_EXT_ADV=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

# Memory optimization
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y

# Debug (set to n for production)
CONFIG_BT_NIMBLE_DEBUG=n
