# Enable frame pointer for better backtraces
CONFIG_ESP_SYSTEM_USE_EH_FRAME=y
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y

# Increase task watchdog timeout (e-paper refresh can be slow)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Enable more verbose logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n

# ============================================================================
# Bluetooth (Bluedroid) Configuration for Inkbird BLE sensors
# Using Bluedroid instead of NimBLE (same as ESPHome)
# ============================================================================

# Enable Bluetooth
CONFIG_BT_ENABLED=y

# Use Bluedroid stack (required for Inkbird IAM-T1 compatibility)
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n

# BLE only mode (no classic Bluetooth needed)
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_BLE_ENABLED=y

# Enable BLE 4.2+ features
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n

# GATT client (we read from sensors)
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTS_ENABLE=n

# Single connection at a time
CONFIG_BT_ACL_CONNECTIONS=1

# Security Manager for pairing if needed
CONFIG_BT_SMP_ENABLE=y

# BLE scan support
CONFIG_BT_BLE_SMP_ENABLE=y

# Controller settings
CONFIG_BT_CTRL_MODE_EFF=1
CONFIG_BT_CTRL_BLE_MAX_ACT=6
CONFIG_BT_CTRL_BLE_MAX_ACT_EFF=6
CONFIG_BT_CTRL_BLE_STATIC_ACL_TX_BUF_NB=0
CONFIG_BT_CTRL_PINNED_TO_CORE=0
CONFIG_BT_CTRL_HCI_MODE_VHCI=y
CONFIG_BT_CTRL_HCI_TL=1
CONFIG_BT_CTRL_ADV_DUP_FILT_MAX=30
CONFIG_BT_CTRL_HW_CCA=n
CONFIG_BT_CTRL_HW_CCA_EFF=0
CONFIG_BT_CTRL_CE_LENGTH_TYPE_EFF=0
CONFIG_BT_CTRL_TX_ANTENNA_INDEX_EFF=0
CONFIG_BT_CTRL_RX_ANTENNA_INDEX_EFF=0
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_EFF=10
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_SUPP=y
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=100
CONFIG_BT_CTRL_BLE_ADV_REPORT_DISCARD_THRSHOLD=20
CONFIG_BT_CTRL_BLE_SCAN_DUPL=y
CONFIG_BT_CTRL_SCAN_DUPL_TYPE=0
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=100
CONFIG_BT_CTRL_DUPL_SCAN_CACHE_REFRESH_PERIOD=0
CONFIG_BT_CTRL_COEX_PHY_CODED_TX_RX_TLIM_EFF=0
CONFIG_BT_CTRL_SLEEP_MODE_EFF=0
CONFIG_BT_CTRL_SLEEP_CLOCK_EFF=0
CONFIG_BT_CTRL_HCI_TL_EFF=1
CONFIG_BT_CTRL_CHAN_ASS_EN=n
CONFIG_BT_CTRL_LE_PING_EN=n
CONFIG_BT_CTRL_BLE_SCAN=y
